{
  "name": "puritanical",
  "version": "3.14.2",
  "description": "Maximum-efficiency dev mode. Zero-fluff prose combined with YAGNI/ladder-first code decisions. One persona: the senior dev who deletes code for fun and bills by the syllable.",
  "author": {
    "name": "Jay Pokale",
    "url": "https://github.com/JayPokale"
  },
  "homepage": "https://github.com/yungSNAT/Puritanical#readme",
  "repository": "https://github.com/yungSNAT/Puritanical",
  "license": "Apache-2.0 AND MIT",
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup|resume|clear|compact",
        "hooks": [
          {
            "type": "command",
            "command": "node \"${CLAUDE_PLUGIN_ROOT}/hooks/puritanical-activate.js\"; exit 0",
            "commandWindows": "if (Get-Command node -ErrorAction SilentlyContinue) { node \"$env:CLAUDE_PLUGIN_ROOT\\hooks\\puritanical-activate.js\" }",
            "timeout": 5,
            "statusMessage": "Loading puritanical mode..."
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"${CLAUDE_PLUGIN_ROOT}/hooks/puritanical-mode-tracker.js\"; exit 0",
            "commandWindows": "if (Get-Command node -ErrorAction SilentlyContinue) { node \"$env:CLAUDE_PLUGIN_ROOT\\hooks\\puritanical-mode-tracker.js\" }",
            "timeout": 5,
            "statusMessage": "Tracking puritanical mode..."
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "node \"${CLAUDE_PLUGIN_ROOT}/hooks/puritanical-run.js\"; exit 0",
            "timeout": 5
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Bash|Agent|WebFetch|WebSearch|Grep|Glob|mcp__.*",
        "hooks": [
          {
            "type": "command",
            "command": "node \"${CLAUDE_PLUGIN_ROOT}/hooks/puritanical-compress-output.js\"; exit 0",
            "commandWindows": "if (Get-Command node -ErrorAction SilentlyContinue) { node \"$env:CLAUDE_PLUGIN_ROOT\\hooks\\puritanical-compress-output.js\" }",
            "timeout": 10,
            "statusMessage": "Compressing tool output..."
          }
        ]
      }
    ]
  }
}

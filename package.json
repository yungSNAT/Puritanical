{
  "name": "puritanical",
  "version": "4.0.0",
  "private": true,
  "description": "Fewer tokens than comparable compression tools, no accuracy lost. Zero-fluff prose, YAGNI-first code, and safe tool-output compression for 13 AI coding agents.",
  "keywords": [
    "claude-code",
    "claude-code-plugin",
    "pi-package",
    "pi-coding-agent",
    "token-optimization",
    "token-reduction",
    "context-compression",
    "llm",
    "ai",
    "anthropic",
    "cost-optimization",
    "cursor",
    "codex",
    "copilot",
    "antigravity",
    "opencode",
    "hermes-agent",
    "hermes",
    "gemini",
    "agents",
    "productivity",
    "yagni",
    "minimal"
  ],
  "license": "Apache-2.0 AND MIT",
  "author": {
    "name": "Jay Pokale",
    "url": "https://github.com/JayPokale"
  },
  "homepage": "https://github.com/yungSNAT/Puritanical#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/yungSNAT/Puritanical.git"
  },
  "bugs": {
    "url": "https://github.com/yungSNAT/Puritanical/issues"
  },
  "bin": {
    "puritanical": "bin/install.js"
  },
  "engines": {
    "node": ">=18"
  },
  "omp": {
    "extensions": [
      "./pi-extension/index.cjs"
    ],
    "skills": [
      "./skills"
    ]
  },
  "pi": {
    "extensions": [
      "./pi-extension/index.js"
    ],
    "skills": [
      "./skills"
    ]
  },
  "scripts": {
    "test": "node --test tests/*.js",
    "build:rules": "cargo run --quiet --locked --manifest-path tools/Cargo.toml -- rules",
    "check:rules": "cargo run --quiet --locked --manifest-path tools/Cargo.toml -- rules --check",
    "build:chart": "cargo run --quiet --locked --manifest-path tools/Cargo.toml -- chart",
    "check:chart": "cargo run --quiet --locked --manifest-path tools/Cargo.toml -- chart --check",
    "bench": "bash benchmarks/run-live.sh",
    "build:readme-art": "cargo run --quiet --locked --manifest-path tools/Cargo.toml -- readme-art",
    "check:readme-art": "cargo run --quiet --locked --manifest-path tools/Cargo.toml -- readme-art --check"
  },
  "files": [
    "bin/",
    "hooks/",
    "pi-extension/",
    "skills/",
    "commands/",
    "rules/",
    "AGENTS.md",
    ".cursor/",
    ".windsurf/",
    ".clinerules/",
    ".kiro/",
    ".agents/",
    ".github/copilot-instructions.md",
    ".claude-plugin/",
    ".opencode/",
    "README.md",
    "LICENSE",
    "NOTICE"
  ]
}
